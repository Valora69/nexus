# Copy to .env and fill in real values. See README.md > Environment.

# Defaults to prod when unset. For local dev against a machine running
# apps/web, use your LAN IP (http://192.168.x.x:3000) — localhost inside a
# physical iPhone will not resolve back to your Mac.
EXPO_PUBLIC_API_URL=https://moneyapp.click

# Required for Google sign-in. Must be an iOS-type OAuth client in the same
# GCP project as the web client. See README.md > Google OAuth setup.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<iOS client id>.apps.googleusercontent.com
